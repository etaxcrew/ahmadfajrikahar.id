# ---------------------------------------------------------------------------
# Contoh konfigurasi environment untuk form kontak.
#  - Lokal (dev)  : salin ke `.env.local`, isi nilainya, restart `npm run dev`.
#  - Vercel       : isi di Project Settings → Environment Variables (jangan upload berkas),
#                   lalu Redeploy agar nilainya terbaca.
# JANGAN pernah commit berkas hasil salinan; .env* (kecuali .env.example) ada di .gitignore.
#
# Semua variabel di bawah HANYA dibaca di sisi server (app/api/contact/route.ts
# lewat lib/email.ts). Tidak ada yang berawalan NEXT_PUBLIC_, jadi tidak ada
# kredensial yang ikut terkirim ke browser.
# ---------------------------------------------------------------------------

# Penyedia pengiriman: smtp | resend
# Kosongkan untuk otomatis: "resend" bila RESEND_API_KEY terisi, selain itu "smtp".
# EMAIL_PROVIDER=smtp

# Tujuan pesan dari form kontak (email kantor — data final).
CONTACT_TO_EMAIL=info@notarisafk.id

# Nama tampilan pengirim. Default: "Website Notaris & PPAT".
# CONTACT_FROM_NAME=Website Notaris & PPAT

# Alamat di header From.
#  - SMTP   : opsional; kosong = memakai SMTP_USER (banyak server menolak From lain).
#  - Resend : WAJIB, dan harus berdomain yang sudah diverifikasi di Resend.
#             Sebelum domain aktif, untuk uji coba bisa memakai onboarding@resend.dev
#             (Resend hanya mengizinkan kirim ke email pemilik akun Resend).
# CONTACT_FROM_EMAIL=

# --- Opsi A: SMTP (Nodemailer) ---------------------------------------------
# Contoh Gmail/Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=alamat gmail, SMTP_PASSWORD=App Password 16 karakter (bukan password akun;
# butuh verifikasi 2 langkah aktif). Port 465 = TLS implisit, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
# Opsional. Kosong = otomatis true bila port 465. Isi manual hanya jika server berbeda.
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# --- Opsi B: Resend ----------------------------------------------------------
# API key dari https://resend.com/api-keys (izin "Sending access" cukup).
# RESEND_API_KEY=

# --- URL situs (opsional) ----------------------------------------------------
# Biasanya TIDAK perlu diisi: di Vercel URL diambil otomatis (lib/site-url.ts).
# Isi hanya untuk memaksa URL tertentu.
# SITE_URL=https://ahmadfajrikahar.id
